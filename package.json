{
  "name": "gimmehttp",
  "author": "Brian Voelker <brian@webiswhatido.com> (https://webiswhatido.com)",
  "version": "2.1.0",
  "description": "HTTP request code generator",
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/brianvoe"
  },
  "bugs": {
    "url": "https://github.com/brianvoe/gimmeHTTP/issues"
  },
  "keywords": [
    "http",
    "request",
    "generator",
    "multi-language",
    "vue",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "github.com/brianvoe/gimmeHTTP"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "dev": "vite --port=1111 --config vite.config.docs.mts",
    "format": "prettier --write --cache --parser typescript \"src/**/*.ts\"",
    "lint": "prettier --write ./src/**/*",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "npm run typecheck && npm run build:clean && npm run build:docs && npm run build:lib && npm run build:vue && npm run build:react",
    "build:clean": "rimraf ./dist/* && rimraf ./docs/*",
    "build:docs": "vite build --config vite.config.docs.mts",
    "build:lib": "npm run build:lib:es-cjs && npm run build:lib:umd-iife && npm run build:lib:css",
    "build:lib:es-cjs": "vite build --config vite.config.lib.es-cjs.ts",
    "build:lib:umd-iife": "vite build --config vite.config.lib.umd-iife.ts",
    "build:lib:css": "sass --no-source-map --style=compressed src/gimmehttp/ui/gimmehttp.scss dist/gimmehttp.css",
    "build:vue": "vite build --config vite.config.vue.mts",
    "build:react": "vite build --config vite.config.react.mts",
    "typecheck": "npx tsc --noEmit",
    "release": "node release.js"
  },
  "main": "dist/gimmehttp.js",
  "browser": "dist/gimmehttp.js",
  "module": "dist/gimmehttp.es.js",
  "unpkg": "dist/gimmehttp.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/gimmehttp.cjs.js",
      "import": "./dist/gimmehttp.es.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "require": "./dist/core/index.cjs.js",
      "import": "./dist/core/index.es.js"
    },
    "./clients": {
      "types": "./dist/clients/index.d.ts",
      "require": "./dist/clients/index.cjs.js",
      "import": "./dist/clients/index.es.js"
    },
    "./css": {
      "default": "./dist/gimmehttp.css"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "require": "./dist/ui/index.cjs.js",
      "import": "./dist/ui/index.es.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "dependencies": {
    "highlight.js": "^11.11.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "vue": "^3.5.22"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/language-core": "^3.3.8",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^30.0.0",
    "prettier": "^3.9.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rimraf": "^6.1.3",
    "sass": "^1.102.0",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.3.8"
  }
}
