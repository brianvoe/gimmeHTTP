{
  "name": "gimmehttp",
  "author": "Brian Voelker <brian@webiswhatido.com> (https://webiswhatido.com)",
  "version": "1.5.1",
  "description": "HTTP request code generator",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/brianvoe/gimmeHTTP/issues"
  },
  "keywords": [
    "http",
    "request",
    "generator",
    "multi-language"
  ],
  "repository": {
    "type": "git",
    "url": "github.com/brianvoe/gimmeHTTP"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "dev": "vite --port=1111 --config vite.config.docs.mts",
    "format": "prettier --write --cache --parser typescript \"src/**/*.ts\"",
    "lint": "prettier --write ./src/**/*",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "npm run typecheck && npm run build:clean && npm run build:docs && npm run build:lib && npm run build:vue",
    "build:clean": "rimraf ./dist/* && rimraf ./docs/*",
    "build:docs": "vite build --config vite.config.docs.mts",
    "build:lib": "npm run build:lib:es-cjs && npm run build:lib:umd-iife",
    "build:lib:es-cjs": "vite build --config vite.config.lib.es-cjs.ts",
    "build:lib:umd-iife": "vite build --config vite.config.lib.umd-iife.ts",
    "build:vue": "vite build --config vite.config.vue.mts",
    "typecheck": "npx tsc --noEmit",
    "release": "node release.js"
  },
  "main": "dist/gimmehttp.js",
  "browser": "dist/gimmehttp.js",
  "module": "dist/gimmehttp.es.js",
  "unpkg": "dist/gimmehttp.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/gimmehttp.cjs.js",
      "import": "./dist/gimmehttp.es.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    },
    "./vue/css": {
      "default": "./dist/vue/gimmehttp.css"
    }
  },
  "peerDependencies": {
    "highlight.js": "^11.0.0",
    "vue": "^3.5.22"
  },
  "peerDependenciesMeta": {
    "highlight.js": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/language-core": "^3.3.8",
    "@vue/test-utils": "^2.4.11",
    "highlight.js": "^11.11.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "sass": "^1.101.7",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.3.8"
  }
}
